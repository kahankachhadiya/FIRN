# Copy to .env and fill in the blank secrets. Never commit .env.
# =============================================================================
# INGESTION PIPELINE ENVIRONMENT CONFIGURATION
# =============================================================================

# =============================================================================
# DATABASE CONNECTION CONFIGURATION
# =============================================================================

# Qdrant Configuration (Vector Search)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_TIMEOUT=10
QDRANT_API_KEY=
QDRANT_MAIN_COLLECTION=main_vectors
QDRANT_PREFER_GRPC=false
QDRANT_HTTPS=false
QDRANT_VERIFY_SSL=true

# Qdrant HNSW Index Configuration
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_INDEXING_THRESHOLD=5000

# FalkorDB Configuration (Unified Knowledge Graph)
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_TIMEOUT=5
FALKORDB_PASSWORD=

# Unified Knowledge Graph Configuration
FALKOR_KNOWLEDGE_GRAPH_NAME=knowledge_graph
FALKOR_VERTEX_COLLECTION=chunks

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_CHUNK_INDEX=chunks
ELASTICSEARCH_METADATA_INDEX=documents

# Falkor DB direct connection fields
FALKOR_HOST=localhost
FALKOR_PORT=6380
FALKOR_USERNAME=
FALKOR_PASSWORD=

# =============================================================================
# INGESTION PIPELINE CONFIGURATION
# =============================================================================

# Graph A Configuration
GRAPH_A_RERANKER_CANDIDATES=25
GRAPH_A_RERANKER_THRESHOLD=0.5
GRAPH_A_TOP_N=10

# Graph B Configuration
VECTOR_SEARCH_TOP_K_PER_PROBE=30
CONFIDENCE_THRESHOLD=0.5
CLASSIFICATION_SLOW_PATH_ENABLED=false
GRAPH_B_TOP_N_DEPENDENCY_EDGES=5
GRAPH_B_TOP_N_EXPANSION_EDGES=5
GRAPH_B_TOP_N_CONTRADICTION_EDGES=5

# =============================================================================
# LLM VISION MODEL CONFIGURATION
# =============================================================================

LLM_VISION_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_VISION_API_KEY=
LLM_VISION_MODEL=qwen/qwen3-vl-32b-instruct
LLM_VISION_MAX_TOKENS=2048
LLM_VISION_TEMPERATURE=0.1

# =============================================================================
# LLM METADATA EXTRACTION CONFIGURATION
# =============================================================================

LLM_METADATA_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_METADATA_API_KEY=
LLM_METADATA_MODEL=openai/gpt-oss-20b:free
LLM_METADATA_MAX_TOKENS=1000
LLM_METADATA_TEMPERATURE=0.1

# =============================================================================
# LLM CLASSIFICATION CONFIGURATION
# =============================================================================

LLM_CLASSIFICATION_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_CLASSIFICATION_API_KEY=
LLM_CLASSIFICATION_MODEL=openai/gpt-oss-20b:free
LLM_CLASSIFICATION_MAX_TOKENS=512
LLM_CLASSIFICATION_TEMPERATURE=0.05

# =============================================================================
# UNIFIED KNOWLEDGE GRAPH SERVICE CONFIGURATION
# =============================================================================

UNIFIED_KG_SERVICE_URL=http://localhost:7997
SERVICE_RETRY_ATTEMPTS=3

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

LOG_FILE_PATH=logs/production.log
CONVERSATION_LOG_PATH=logs/conversation_debug.jsonl
STRUCTURED_LOGGING_ENABLED=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

AUTH_ENABLED=false
AUTH_TYPE=api_key
JWT_SECRET=
JWT_EXPIRY=3600

RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=10
RATE_LIMIT_WINDOW=60
RATE_LIMIT_CLEANUP_INTERVAL=300
RATE_LIMIT_ENABLE_BURST=true
RATE_LIMIT_ENABLE_HISTORY=true
RATE_LIMIT_INCLUDE_HEADERS=true
RATE_LIMIT_HEADER_PREFIX=X-RateLimit
RATE_LIMIT_EXPOSE_RETRY_AFTER=true

IP_WHITELIST=
IP_BLACKLIST=

ENCRYPT_LOGS=false
ENCRYPT_CACHE=false
SECURE_HEADERS=true
