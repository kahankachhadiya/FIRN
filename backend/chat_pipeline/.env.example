# Copy to .env and fill in the blank secrets. Never commit .env.
# =============================================================================
# CHAT PIPELINE ENVIRONMENT CONFIGURATION
# =============================================================================


# =============================================================================
# DATABASE CONNECTION CONFIGURATION
# =============================================================================

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_CHUNK_INDEX=chunks
ELASTICSEARCH_METADATA_INDEX=documents

# Qdrant Configuration (Vector Search)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_TIMEOUT=10
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_HTTPS=false
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_INDEXING_THRESHOLD=5000
QDRANT_MAIN_COLLECTION=main_vectors

# Falkor DB direct connection fields
FALKOR_HOST=localhost
FALKOR_PORT=6380
FALKOR_USERNAME=
FALKOR_PASSWORD=

# Unified Knowledge Graph Configuration
FALKOR_KNOWLEDGE_GRAPH_NAME=knowledge_graph
FALKOR_VERTEX_COLLECTION=chunks

# =============================================================================
# LLM CHAT MODEL CONFIGURATION
# =============================================================================

LLM_CHAT_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=openai/gpt-oss-20b:free
LLM_CHAT_MAX_TOKENS=10000
LLM_CHAT_TEMPERATURE=0.05

# =============================================================================
# LLM TIMEOUT CONFIGURATION
# =============================================================================

LLM_QUERY_GENERATION_TIMEOUT=999
LLM_RESPONSE_GENERATION_TIMEOUT=999
LLM_MAX_RETRIES=2

# =============================================================================
# RETRIEVAL PIPELINE CONFIGURATION
# =============================================================================

# Search Configuration
VECTOR_SEARCH_TOP_K=12
KEYWORD_SEARCH_TOP_K=12
VECTOR_TOP_CHUNKS=6
KEYWORD_TOP_CHUNKS=6
RERANKED_TOP_CHUNKS=10

# Graph B per-probe top-N
GRAPH_B_CONTRADICTS_TOP_N=2
GRAPH_B_ELABORATES_TOP_N=5
GRAPH_B_DEPENDS_ON_TOP_N=3

# Context Expansion Configuration
CONTEXT_EXPANSION_ENABLED=true
CONTEXT_ADJACENT_CHUNKS=2

# Final Output Limits
MAX_FINAL_CHUNKS=25

# =============================================================================
# GRAPH A CONFIGURATION
# =============================================================================

GRAPH_A_TOP_N=10

# =============================================================================
# SESSION / MEMORY / CHAT HISTORY CONFIGURATION
# =============================================================================

CHAT_HISTORY_DIR=data/chat_history

# =============================================================================
# TOOL CALLING CONFIGURATION
# =============================================================================

MAX_RETRIEVAL_ROUNDS=1
TOOL_EXECUTION_TIMEOUT=30

# RAG Tool Configuration
RAG_TOOL_REQUEST_TIMEOUT=999
RAG_TOOL_QUERY_GENERATION_TIMEOUT=999
RAG_TOOL_PIPELINE_TIMEOUT=999

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=150
RATE_LIMIT_BURST=10
RATE_LIMIT_WINDOW=60
RATE_LIMIT_CLEANUP_INTERVAL=300
RATE_LIMIT_ENABLE_BURST=true
RATE_LIMIT_ENABLE_HISTORY=true
RATE_LIMIT_INCLUDE_HEADERS=true
RATE_LIMIT_HEADER_PREFIX=X-RateLimit
RATE_LIMIT_EXPOSE_RETRY_AFTER=true

# =============================================================================
# FILE ACCESS SECURITY CONFIGURATION
# =============================================================================

ALLOWED_FILE_EXTENSIONS=["pdf","png","jpg","jpeg","gif","webp"]

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================

API_HOST=localhost
API_PORT=8000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

LOG_LEVEL=INFO

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

IP_WHITELIST=
IP_BLACKLIST=

